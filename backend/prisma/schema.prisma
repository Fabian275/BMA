generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "darwin-arm64", "windows", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model language {
  id     Int     @id @default(autoincrement())
  code   String  @db.VarChar(5) @unique
  name   String  @db.VarChar(50)

  users  user[]
}

model user {
  id              Int      @id @default(autoincrement())
  username        String   @unique @db.VarChar(100)
  password_hash   String   @db.VarChar(150)
  language_id     Int

  language        language @relation(fields: [language_id], references: [id])
  transcription_info transcription_info[]
}

model transcription_info {
  id           Int      @id @default(autoincrement())
  user_id      Int
  title        String   @db.VarChar(100)
  location     String   @db.VarChar(100)
  date         DateTime @default(now()) @db.Timestamptz
  description  String   @db.Text
  is_closed    Boolean  @default(false)

  user         user             @relation(fields: [user_id], references: [id])
  transcription transcription?
}

model transcription {
  id                     Int    @id @default(autoincrement())
  transcription_info_id  Int   @unique
  transcribed_text       String @db.Text
  file_path              String @db.VarChar(255)

  transcription_info     transcription_info @relation(fields: [transcription_info_id], references: [id])
}
